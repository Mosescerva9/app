# Operating mode: RESEARCH | PAPER | LIVE_APPROVAL
# LIVE_APPROVAL is disabled in Phase 2 regardless of this value.
TRADING_MODE=RESEARCH

# Data/broker provider: mock | webull
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=mock
# Catalyst/events: auto (webull when MARKET_DATA_PROVIDER=webull) | mock | webull
# Mock never invents news or earnings dates.
CATALYST_PROVIDER=auto
# Fundamentals (forecast EPS + official statements/indicators): auto | mock | webull
# Mock never invents EPS, ratios, or statements.
FUNDAMENTALS_PROVIDER=auto

# Webull OpenAPI (never commit real secrets)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
# sandbox: api.sandbox.webull.com | production: api.webull.com
# Account IDs are endpoint-specific. Use TradeClient.account_v2.get_account_list()
# (or `python -m trading_system account`) on THIS host. App paper-trading IDs
# and production IDs will get ACCOUNT_ACCESS_DENIED on sandbox, and vice versa.
WEBULL_API_ENDPOINT=api.sandbox.webull.com
WEBULL_ACCOUNT_ID=

# Risk defaults for ~$1,500 research account
ACCOUNT_EQUITY_USD=1500
MAX_RISK_PER_TRADE_PCT=0.10
MAX_SIMULTANEOUS_POSITIONS=2
MAX_DAILY_LOSS_PCT=0.05
MAX_WEEKLY_LOSS_PCT=0.10

# Kill switch — when true, no orders may be submitted in any future phase
EMERGENCY_STOP=false

LOG_LEVEL=INFO
