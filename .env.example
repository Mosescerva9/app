# Discord
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Comma-separated channel IDs to monitor (leave empty to monitor all channels the bot can see)
DISCORD_CHANNEL_IDS=
# Optional: only act on messages from these user/bot IDs (comma-separated)
DISCORD_ALERT_AUTHOR_IDS=

# Webull OpenAPI (https://www.webull.com/center#openApiManagement)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
# Region code: us (default)
WEBULL_REGION=us
# Production: api.webull.com | Sandbox: api.sandbox.webull.com
WEBULL_API_ENDPOINT=api.sandbox.webull.com

# Trading behavior
# dry_run=true logs orders without submitting to Webull
DRY_RUN=true
# Default contracts if alert omits quantity
DEFAULT_QUANTITY=1
# Max contracts per alert (safety cap)
MAX_QUANTITY=10
# Buy: pay up to alert_price * (1 + BUY_SLIPPAGE). Sell: accept down to alert_price * (1 - SELL_SLIPPAGE).
BUY_SLIPPAGE=0.05
SELL_SLIPPAGE=0.05
# If alert has no price, skip (safer) or use a fallback — leave empty to require price
REQUIRE_LIMIT_PRICE=true

# Persistence
POSITIONS_DB_PATH=./data/positions.db
LOG_LEVEL=INFO