# Operating mode: RESEARCH | PAPER | LIVE_APPROVAL
# LIVE_APPROVAL is disabled in Phase 2 regardless of this value.
TRADING_MODE=RESEARCH

# Data/broker provider: mock | webull
MARKET_DATA_PROVIDER=mock
BROKER_PROVIDER=mock

# Webull OpenAPI (never commit real secrets)
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_REGION=us
# sandbox: api.sandbox.webull.com | production: api.webull.com
WEBULL_API_ENDPOINT=api.sandbox.webull.com
WEBULL_ACCOUNT_ID=

# Risk defaults for ~$1,000 account (enforced in later phases; stored now)
ACCOUNT_EQUITY_USD=1000
MAX_RISK_PER_TRADE_PCT=0.04
MAX_SIMULTANEOUS_POSITIONS=2
MAX_DAILY_LOSS_PCT=0.05
MAX_WEEKLY_LOSS_PCT=0.10

# Kill switch — when true, no orders may be submitted in any future phase
EMERGENCY_STOP=false

LOG_LEVEL=INFO
